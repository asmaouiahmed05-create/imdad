// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                    String                     @id @default(cuid())
  name                  String
  sku                   String                     @unique
  unit                  String
  quantity              Float                      @default(0)
  minQuantity           Float                      @default(0)
  classification        ProductClassification      @default(UNCLASSIFIED)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  movements             StockMovement[]
  purchaseOrderLines    PurchaseOrderLine[]
  finishedProductBoms   BillOfMaterials[]          @relation("BOMFinishedProduct")
  materialBomComponents BillOfMaterialsComponent[] @relation("BOMMaterialProduct")
  customerOrderLines    CustomerOrderLine[]
  customerReservations  CustomerOrderReservation[]

  @@index([classification, name])
}

enum MovementType {
  IN
  OUT
}

enum ProductClassification {
  UNCLASSIFIED
  MATERIAL
  FINISHED_GOOD
  BOTH
}

enum BillOfMaterialsStatus {
  DRAFT
  RELEASED
  RETIRED
}

enum ProductionOrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Positive BOM/revision/order quantity and order-date CHECK constraints are maintained in SQL migrations because Prisma schema syntax cannot declare them.
model BillOfMaterials {
  id                  String                     @id @default(cuid())
  finishedProductId   String
  finishedProduct     Product                    @relation("BOMFinishedProduct", fields: [finishedProductId], references: [id], onDelete: Restrict)
  finishedProductName String
  finishedProductSku  String
  finishedProductUnit String
  revision            Int
  status              BillOfMaterialsStatus      @default(DRAFT)
  components          BillOfMaterialsComponent[]
  productionOrders    ProductionOrder[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  releasedAt          DateTime?
  retiredAt           DateTime?

  @@unique([finishedProductId, revision])
  @@index([finishedProductId, status, revision])
}

model BillOfMaterialsComponent {
  id                String          @id @default(cuid())
  bomId             String
  bom               BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Restrict)
  materialProductId String
  materialProduct   Product         @relation("BOMMaterialProduct", fields: [materialProductId], references: [id], onDelete: Restrict)
  quantityPerUnit   Decimal         @db.Decimal(18, 6)
  materialName      String
  materialSku       String
  unit              String
  createdAt         DateTime        @default(now())

  @@unique([bomId, materialProductId])
  @@index([materialProductId])
}

model StockMovement {
  id                  String                @id @default(cuid())
  type                MovementType
  quantity            Float
  reason              String?
  reference           String?
  createdAt           DateTime              @default(now())
  productId           String
  product             Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine?    @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  receiptId           String?
  receipt             PurchaseOrderReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  productionOrderId   String?
  productionOrder     ProductionOrder?      @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  customerOrderId     String?
  customerOrder       CustomerOrder?        @relation(fields: [customerOrderId], references: [id], onDelete: Restrict)

  @@unique([productionOrderId, productId, type])
  @@unique([customerOrderId, productId, type])
  @@index([productId])
  @@index([purchaseOrderLineId])
  @@index([receiptId])
  @@index([productionOrderId])
  @@index([customerOrderId])
}

model ProductionOrder {
  id                     String                @id @default(cuid())
  orderNumber            String                @unique
  status                 ProductionOrderStatus @default(DRAFT)
  bomId                  String
  bom                    BillOfMaterials       @relation(fields: [bomId], references: [id], onDelete: Restrict)
  plannedQuantity        Decimal               @db.Decimal(18, 6)
  producedQuantity       Decimal?              @db.Decimal(18, 6)
  plannedStartDate       DateTime?
  expectedCompletionDate DateTime?
  notes                  String?
  movements              StockMovement[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?

  @@index([status, createdAt])
  @@index([bomId, createdAt])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  nameKey        String          @unique
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([isActive, name])
}

model PurchaseOrder {
  id          String                 @id @default(cuid())
  orderNumber String                 @unique
  status      PurchaseOrderStatus    @default(DRAFT)
  supplierId  String
  supplier    Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines       PurchaseOrderLine[]
  receipts    PurchaseOrderReceipt[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  submittedAt DateTime?
  receivedAt  DateTime?
  cancelledAt DateTime?

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
}

model PurchaseOrderReceipt {
  id              String          @id @default(cuid())
  idempotencyKey  String          @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  movements       StockMovement[]
  createdAt       DateTime        @default(now())

  @@index([purchaseOrderId, createdAt])
}

model PurchaseOrderLine {
  id               String          @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName      String
  productSku       String
  unit             String
  orderedQuantity  Float
  receivedQuantity Float           @default(0)
  movements        StockMovement[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum CustomerOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum ReservationReleaseReason {
  FULFILLED
  CANCELLED
}

model Customer {
  id            String          @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  city          String?
  address       String?
  notes         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orders        CustomerOrder[]

  @@index([name])
  @@index([isActive, name])
}

model CustomerOrder {
  id                    String                     @id @default(cuid())
  orderNumber           String                     @unique
  idempotencyKey        String
  status                CustomerOrderStatus        @default(DRAFT)
  customerId            String
  customer              Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName          String
  createdByUserId       String
  createdBy             User                       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines                 CustomerOrderLine[]
  reservations          CustomerOrderReservation[]
  movements             StockMovement[]
  expectedFulfillmentAt DateTime?
  notes                 String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  confirmedAt           DateTime?
  fulfilledAt           DateTime?
  cancelledAt           DateTime?

  @@unique([createdByUserId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model CustomerOrderLine {
  id              String                     @id @default(cuid())
  orderId         String
  order           CustomerOrder              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId       String
  product         Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName     String
  productSku      String
  unit            String
  orderedQuantity Float
  reservations    CustomerOrderReservation[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([orderId, productId])
  @@index([productId])
}

model CustomerOrderReservation {
  id            String                    @id @default(cuid())
  orderId       String
  order         CustomerOrder             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLineId   String                    @unique
  orderLine     CustomerOrderLine         @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  productId     String
  product       Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Float
  createdAt     DateTime                  @default(now())
  releasedAt    DateTime?
  releaseReason ReservationReleaseReason?

  @@index([productId, releasedAt])
  @@index([orderId, releasedAt])
}

model User {
  id            String          @id
  name          String
  email         String          @unique
  emailVerified Boolean         @default(false)
  image         String?
  role          String?
  banned        Boolean?        @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  salesOrders   CustomerOrder[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@map("verification")
}
